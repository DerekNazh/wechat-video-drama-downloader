# 项目版本（单一事实源为仓库根目录 VERSION 文件，此处仅作 .env 兼容兜底）
PROJECT_VERSION=1.3.1

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 前端轮询后端服务状态的间隔（秒）
WX_STATUS_INTERVAL=5

# 视频下载目录（相对 app_root，也可用绝对路径）
WX_DOWNLOAD_DIR=下载

# 短剧嗅探服务端口（res_download.exe）
RES_PORT=8899

# 短剧嗅探上游代理端口（weixin_download 内部代理）
RES_UPSTREAM_PORT=2023

# 启动时自动开启系统代理（默认关闭，需在设置中手动开启）
RES_AUTO_PROXY=false

# 嗅探透传请求超时（秒）
SNIFF_PROXY_TIMEOUT=15.0

# direct-download 大文件下载超时（秒）
SNIFF_DOWNLOAD_TIMEOUT=120.0

# 广告总开关（true=显示 / false=隐藏）
ADS_ENABLED=true

# pywebview 调试模式（true=开启开发者工具 / false=关闭）
PYWEBVIEW_DEBUG=false
